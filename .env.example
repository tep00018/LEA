# OpenAI Configuration (Required)
OPENAI_API_KEY=sk-your-key-here

# Redis Configuration (Required)
REDIS_URL=redis://localhost:6379
# For Redis with password: redis://:password@localhost:6379
# For Redis Cloud: redis://username:password@host:port

# YouTube API (Optional - for worked examples)
YOUTUBE_API_KEY=your-youtube-api-key-here

# Application Configuration
ENVIRONMENT=development
LOG_LEVEL=INFO

# ngrok Configuration (Optional - for external access)
NGROK_AUTH_TOKEN=your-ngrok-token-here

# Optional: LangSmith (for debugging/monitoring)
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=LEA

# Optional: Literal AI
LITERALAI_API_KEY=
